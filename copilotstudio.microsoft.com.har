 developers to integrate powerful AI models with search capabilities.\\\\\\\\nThis API is OpenAI-compatible for easy integration with existing applications.\\\\\\\\n\\\\\\\",\\\\\\\"openApiDefinition\\\\\\\":{\\\\\\\"swagger\\\\\\\":\\\\\\\"2.0\\\\\\\",\\\\\\\"host\\\\\\\":\\\\\\\"api.perplexity.ai\\\\\\\",\\\\\\\"schemes\\\\\\\":[\\\\\\\"https\\\\\\\"],\\\\\\\"definitions\\\\\\\":{\\\\\\\"ChatCompletionRequest\\\\\\\":{\\\\\\\"required\\\\\\\":[\\\\\\\"model\\\\\\\",\\\\\\\"messages\\\\\\\"],\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"properties\\\\\\\":{\\\\\\\"model\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"ID of the model to use\\\\\\\",\\\\\\\"enum\\\\\\\":[\\\\\\\"sonar-deep-research\\\\\\\",\\\\\\\"sonar-reasoning-pro\\\\\\\",\\\\\\\"sonar-pro\\\\\\\",\\\\\\\"sonar\\\\\\\",\\\\\\\"r1-1776\\\\\\\"],\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\",\\\\\\\"example\\\\\\\":\\\\\\\"sonar-pro\\\\\\\"},\\\\\\\"messages\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"A list of messages comprising the conversation so far\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"array\\\\\\\",\\\\\\\"items\\\\\\\":{\\\\\\\"$ref\\\\\\\":\\\\\\\"#/definitions/Message\\\\\\\"},\\\\\\\"example\\\\\\\":[{\\\\\\\"role\\\\\\\":\\\\\\\"system\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"Be precise and concise.\\\\\\\"},{\\\\\\\"role\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"How many stars are there in our galaxy?\\\\\\\"}]},\\\\\\\"max_tokens\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"The maximum number of completion tokens returned by the API.\\\\\\\\nThe number of tokens requested in max_tokens plus the number of prompt tokens sent in messages\\\\\\\\nmust not exceed the context window token limit of model requested.\\\\\\\\n\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"integer\\\\\\\",\\\\\\\"example\\\\\\\":1024},\\\\\\\"temperature\\\\\\\":{\\\\\\\"format\\\\\\\":\\\\\\\"float\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"What sampling temperature to use, between 0 and 2.\\\\\\\\nHigher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic.\\\\\\\\n\\\\\\\",\\\\\\\"default\\\\\\\":1,\\\\\\\"maximum\\\\\\\":2,\\\\\\\"minimum\\\\\\\":0,\\\\\\\"type\\\\\\\":\\\\\\\"number\\\\\\\",\\\\\\\"example\\\\\\\":0.7},\\\\\\\"top_p\\\\\\\":{\\\\\\\"format\\\\\\\":\\\\\\\"float\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass.\\\\\\\\nSo 0.1 means only the tokens comprising the top 10% probability mass are considered.\\\\\\\\n\\\\\\\",\\\\\\\"default\\\\\\\":1,\\\\\\\"maximum\\\\\\\":1,\\\\\\\"minimum\\\\\\\":0,\\\\\\\"type\\\\\\\":\\\\\\\"number\\\\\\\",\\\\\\\"example\\\\\\\":0.9},\\\\\\\"stream\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"If set, partial message deltas will be sent, like in ChatGPT.\\\\\\\\nTokens will be sent as data-only server-sent events as they become available,\\\\\\\\nwith the stream terminated by a data: [DONE] message.\\\\\\\\n\\\\\\\",\\\\\\\"default\\\\\\\":false,\\\\\\\"type\\\\\\\":\\\\\\\"boolean\\\\\\\",\\\\\\\"example\\\\\\\":false},\\\\\\\"response_format\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"An object specifying the format that the model must output.\\\\\\\\nUsed for structured outputs like JSON or regex patterns.\\\\\\\\n\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"properties\\\\\\\":{\\\\\\\"type\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"The type of structured output format\\\\\\\",\\\\\\\"enum\\\\\\\":[\\\\\\\"json_schema\\\\\\\",\\\\\\\"regex\\\\\\\"],\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\",\\\\\\\"example\\\\\\\":\\\\\\\"json_schema\\\\\\\"},\\\\\\\"json_schema\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"A valid JSON schema object (when type is json_schema)\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"example\\\\\\\":{\\\\\\\"schema\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"properties\\\\\\\":{\\\\\\\"first_name\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\"},\\\\\\\"last_name\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\"},\\\\\\\"year_of_birth\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"integer\\\\\\\"},\\\\\\\"num_seasons_in_nba\\\\\\\":{\\\\\\\"type\\\\\\\":\\\\\\\"integer\\\\\\\"}},\\\\\\\"required\\\\\\\":[\\\\\\\"first_name\\\\\\\",\\\\\\\"last_name\\\\\\\",\\\\\\\"year_of_birth\\\\\\\",\\\\\\\"num_seasons_in_nba\\\\\\\"]}}},\\\\\\\"regex\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"A regex pattern object (when type is regex)\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"example\\\\\\\":{\\\\\\\"regex\\\\\\\":\\\\\\\"(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\\\\\\\\\\\\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\\\\"}}}}}},\\\\\\\"Message\\\\\\\":{\\\\\\\"required\\\\\\\":[\\\\\\\"role\\\\\\\",\\\\\\\"content\\\\\\\"],\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"properties\\\\\\\":{\\\\\\\"role\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"The role of the message author\\\\\\\",\\\\\\\"enum\\\\\\\":[\\\\\\\"system\\\\\\\",\\\\\\\"user\\\\\\\",\\\\\\\"assistant\\\\\\\"],\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\",\\\\\\\"example\\\\\\\":\\\\\\\"user\\\\\\\"},\\\\\\\"content\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"The content of the message\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\",\\\\\\\"example\\\\\\\":\\\\\\\"How many stars are there in our galaxy?\\\\\\\"}}},\\\\\\\"ChatCompletionResponse\\\\\\\":{\\\\\\\"required\\\\\\\":[\\\\\\\"id\\\\\\\",\\\\\\\"object\\\\\\\",\\\\\\\"created\\\\\\\",\\\\\\\"model\\\\\\\",\\\\\\\"choices\\\\\\\",\\\\\\\"usage\\\\\\\"],\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"properties\\\\\\\":{\\\\\\\"id\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"A unique identifier for the chat completion\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\",\\\\\\\"example\\\\\\\":\\\\\\\"chatcmpl-123456789\\\\\\\"},\\\\\\\"object\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"The object type, which is always 'chat.completion'\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\",\\\\\\\"example\\\\\\\":\\\\\\\"chat.completion\\\\\\\"},\\\\\\\"created\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"The Unix timestamp (in seconds) of when the chat completion was created\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"integer\\\\\\\",\\\\\\\"example\\\\\\\":1677858242},\\\\\\\"model\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"The model used for the chat completion\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\",\\\\\\\"example\\\\\\\":\\\\\\\"sonar-pro\\\\\\\"},\\\\\\\"choices\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"A list of chat completion choices. Can be more than one if n>1 is specified\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"array\\\\\\\",\\\\\\\"items\\\\\\\":{\\\\\\\"required\\\\\\\":[\\\\\\\"message\\\\\\\",\\\\\\\"index\\\\\\\",\\\\\\\"finish_reason\\\\\\\"],\\\\\\\"type\\\\\\\":\\\\\\\"object\\\\\\\",\\\\\\\"properties\\\\\\\":{\\\\\\\"message\\\\\\\":{\\\\\\\"$ref\\\\\\\":\\\\\\\"#/definitions/Message\\\\\\\"},\\\\\\\"index\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"The index of the choice in the list of choices\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"integer\\\\\\\",\\\\\\\"example\\\\\\\":0},\\\\\\\"finish_reason\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"The reason the model stopped generating tokens.\\\\\\\\nThis could be \\\\\\\\\\\\\\\"stop\\\\\\\\\\\\\\\" if it reached a natural stopping point or a specified stop sequence,\\\\\\\\n\\\\\\\\\\\\\\\"length\\\\\\\\\\\\\\\" if it hit the token limit, or \\\\\\\\\\\\\\\"content_filter\\\\\\\\\\\\\\\" if the content was filtered.\\\\\\\\n\\\\\\\",\\\\\\\"enum\\\\\\\":[\\\\\\\"stop\\\\\\\",\\\\\\\"length\\\\\\\",\\\\\\\"content_filter\\\\\\\"],\\\\\\\"type\\\\\\\":\\\\\\\"string\\\\\\\",\\\\\\\"example\\\\\\\":\\\\\\\"stop\\\\\\\"}}}},\\\\\\\"usage\\\\\\\":{\\\\\\\"description\\\\\\\":\\\\\\\"Usage statistics for the completion request\\\