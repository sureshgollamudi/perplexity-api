            "text": "{\"apiContract\":\"{\\n  \\\"swagger\\\": \\\"2.0\\\",\\n  \\\"info\\\": {\\n    \\\"title\\\": \\\"Perplexity API\\\",\\n    \\\"description\\\": \\\"The Perplexity API allows developers to integrate powerful AI models with search capabilities.\\\\nThis API is OpenAI-compatible for easy integration with existing applications.\\\\n\\\",\\n    \\\"contact\\\": {\\n      \\\"url\\\": \\\"https://docs.perplexity.ai\\\"\\n    },\\n    \\\"version\\\": \\\"1.0.0\\\"\\n  },\\n  \\\"host\\\": \\\"api.perplexity.ai\\\",\\n  \\\"schemes\\\": [\\n    \\\"https\\\"\\n  ],\\n  \\\"paths\\\": {\\n    \\\"/chat/completions\\\": {\\n      \\\"post\\\": {\\n        \\\"tags\\\": [\\n          \\\"Chat\\\"\\n        ],\\n        \\\"summary\\\": \\\"Generates a model's response for the given chat conversation\\\",\\n        \\\"operationId\\\": \\\"createChatCompletion\\\",\\n        \\\"consumes\\\": [\\n          \\\"application/json\\\"\\n        ],\\n        \\\"produces\\\": [\\n          \\\"application/json\\\"\\n        ],\\n        \\\"parameters\\\": [\\n          {\\n            \\\"in\\\": \\\"body\\\",\\n            \\\"name\\\": \\\"body\\\",\\n            \\\"required\\\": true,\\n            \\\"schema\\\": {\\n              \\\"$ref\\\": \\\"#/definitions/ChatCompletionRequest\\\"\\n            }\\n          }\\n        ],\\n        \\\"responses\\\": {\\n          \\\"200\\\": {\\n            \\\"description\\\": \\\"Successful response\\\",\\n            \\\"schema\\\": {\\n              \\\"$ref\\\": \\\"#/definitions/ChatCompletionResponse\\\"\\n            }\\n          },\\n          \\\"400\\\": {\\n            \\\"description\\\": \\\"Bad request\\\",\\n            \\\"schema\\\": {\\n              \\\"$ref\\\": \\\"#/definitions/ErrorResponse\\\"\\n            }\\n          },\\n          \\\"401\\\": {\\n            \\\"description\\\": \\\"Unauthorized\\\",\\n            \\\"schema\\\": {\\n              \\\"$ref\\\": \\\"#/definitions/ErrorResponse\\\"\\n            }\\n          },\\n          \\\"429\\\": {\\n            \\\"description\\\": \\\"Rate limit exceeded\\\",\\n            \\\"schema\\\": {\\n              \\\"$ref\\\": \\\"#/definitions/ErrorResponse\\\"\\n            }\\n          },\\n          \\\"500\\\": {\\n            \\\"description\\\": \\\"Internal server error\\\",\\n            \\\"schema\\\": {\\n              \\\"$ref\\\": \\\"#/definitions/ErrorResponse\\\"\\n            }\\n          }\\n        }\\n      }\\n    }\\n  },\\n  \\\"definitions\\\": {\\n    \\\"ChatCompletionRequest\\\": {\\n      \\\"required\\\": [\\n        \\\"model\\\",\\n        \\\"messages\\\"\\n      ],\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"model\\\": {\\n          \\\"description\\\": \\\"ID of the model to use\\\",\\n          \\\"enum\\\": [\\n            \\\"sonar-deep-research\\\",\\n            \\\"sonar-reasoning-pro\\\",\\n            \\\"sonar-pro\\\",\\n            \\\"sonar\\\",\\n            \\\"r1-1776\\\"\\n          ],\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"example\\\": \\\"sonar-pro\\\"\\n        },\\n        \\\"messages\\\": {\\n          \\\"description\\\": \\\"A list of messages comprising the conversation so far\\\",\\n          \\\"type\\\": \\\"array\\\",\\n          \\\"items\\\": {\\n            \\\"$ref\\\": \\\"#/definitions/Message\\\"\\n          },\\n          \\\"example\\\": [\\n            {\\n              \\\"role\\\": \\\"system\\\",\\n              \\\"content\\\": \\\"Be precise and concise.\\\"\\n            },\\n            {\\n              \\\"role\\\": \\\"user\\\",\\n              \\\"content\\\": \\\"How many stars are there in our galaxy?\\\"\\n            }\\n          ]\\n        },\\n        \\\"max_tokens\\\": {\\n          \\\"description\\\": \\\"The maximum number of completion tokens returned by the API.\\\\nThe number of tokens requested in max_tokens plus the number of prompt tokens sent in messages\\\\nmust not exceed the context window token limit of model requested.\\\\n\\\",\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"example\\\": 1024\\n        },\\n        \\\"temperature\\\": {\\n          \\\"format\\\": \\\"float\\\",\\n          \\\"description\\\": \\\"What sampling temperature to use, between 0 and 2.\\\\nHigher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic.\\\\n\\\",\\n          \\\"default\\\": 1,\\n          \\\"maximum\\\": 2,\\n          \\\"minimum\\\": 0,\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"example\\\": 0.7\\n        },\\n        \\\"top_p\\\": {\\n          \\\"format\\\": \\\"float\\\",\\n          \\\"description\\\": \\\"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass.\\\\nSo 0.1 means only the tokens comprising the top 10% probability mass are considered.\\\\n\\\",\\n          \\\"default\\\": 1,\\n          \\\"maximum\\\": 1,\\n          \\\"minimum\\\": 0,\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"example\\\": 0.9\\n        },\\n        \\\"stream\\\": {\\n          \\\"description\\\": \\\"If set, partial message deltas will be sent, like in ChatGPT.\\\\nTokens will be sent as data-only server-sent events as they become available,\\\\nwith the stream terminated by a data: [DONE] message.\\\\n\\\",\\n          \\\"default\\\": false,\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"example\\\": false\\n        },\\n        \\\"response_format\\\": {\\n          \\\"description\\\": \\\"An object specifying the format that the model must output.\\\\nUsed for structured outputs like JSON or regex patterns.\\\\n\\\",\\n          \\\"type\\\": \\\"object\\\",\\n          \\\"properties\\\": {\\n            \\\"type\\\": {\\n              \\\"description\\\": \\\"The type of structured output format\\\",\\n              \\\"enum\\\": [\\n                \\\"json_schema\\\",\\n                \\\"regex\\\"\\n              ],\\n              \\\"type\\\": \\\"string\\\",\\n              \\\"example\\\": \\\"json_schema\\\"\\n            },\\n            \\\"json_schema\\\": {\\n              \\\"description\\\": \\\"A valid JSON schema object (when type is json_schema)\\\",\\n              \\\"type\\\": \\\"object\\\",\\n              \\\"example\\\": {\\n                \\\"schema\\\": {\\n                  \\\"type\\\": \\\"object\\\",\\n                  \\\"properties\\\": {\\n                    \\\"first_name\\\": {\\n                      \\\"type\\\": \\\"string\\\"\\n                    },\\n                    \\\"last_name\\\": {\\n                      \\\"type\\\": \\\"string\\\"\\n                    },\\n                    \\\"year_of_birth\\\": {\\n                      \\\"type\\\": \\\"integer\\\"\\n                    },\\n                    \\\"num_seasons_in_nba\\\": {\\n                      \\\"type\\\": \\\"integer\\\"\\n                    }\\n                  },\\n                  \\\"required\\\": [\\n                    \\\"first_name\\\",\\n                    \\\"last_name\\\",\\n                    \\\"year_of_birth\\\",\\n                    \\\"num_seasons_in_nba\\\"\\n                  ]\\n                }\\n              }\\n            },\\n            \\\"regex\\\": {\\n              \\\"description\\\": \\\"A regex pattern object (when type is regex)\\\",\\n              \\\"type\\\": \\\"object\\\",\\n              \\\"example\\\": {\\n                \\\"regex\\\": \\\"(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\\\\\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\\"\\n              }\\n            }\\n          }\\n        }\\n      }\\n    },\\n    \\\"Message\\\": {\\n      \\\"required\\\": [\\n        \\\"role\\\",\\n        \\\"content\\\"\\n      ],\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"role\\\": {\\n          \\\"description\\\": \\\"The role of the message author\\\",\\n          \\\"enum\\\": [\\n            \\\"system\\\",\\n            \\\"user\\\",\\n            \\\"assistant\\\"\\n          ],\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"example\\\": \\\"user\\\"\\n        },\\n        \\\"content\\\": {\\n          \\\"description\\\": \\\"The content of the message\\\",\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"example\\\": \\\"How many stars are there in our galaxy?\\\"\\n        }\\n      }\\n    },\\n    \\\"ChatCompletionResponse\\\": {\\n      \\\"required\\\": [\\n        \\\"id\\\",\\n        \\\"object\\\",\\n        \\\"created\\\",\\n        \\\"model\\\",\\n        \\\"choices\\\",\\n        \\\"usage\\\"\\n      ],\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"id\\\": {\\n          \\\"description\\\": \\\"A unique identifier for the chat completion\\\",\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"example\\\": \\\"chatcmpl-123456789\\\"\\n        },\\n        \\\"object\\\": {\\n          \\\"description\\\": \\\"The object type, which is always 'chat.completion'\\\",\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"example\\\": \\\"chat.completion\\\"\\n        },\\n        \\\"created\\\": {\\n          \\\"description\\\": \\\"The Unix timestamp (in seconds) of when the chat completion was created\\\",\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"example\\\": 1677858242\\n        },\\n        \\\"model\\\": {\\n          \\\"description\\\": \\\"The model used for the chat completion\\\",\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"example\\\": \\\"sonar-pro\\\"\\n        },\\n        \\\"choices\\\": {\\n          \\\"description\\\": \\\"A list of chat completion choices. Can be more than one if n>1 is specified\\\",\\n          \\\"type\\\": \\\"array\\\",\\n          \\\"items\\\": {\\n            \\\"required\\\": [\\n              \\\"message\\\",\\n              \\\"index\\\",\\n              \\\"finish_reason\\\"\\n            ],\\n            \\\"type\\\": \\\"object\\\",\\n            \\\"properties\\\": {\\n              \\\"message\\\": {\\n                \\\"$ref\\\": \\\"#/definitions/Message\\\"\\n              },\\n              \\\"index\\\": {\\n                \\\"description\\\": \\\"The index of the choice in the list of choices\\\",\\n                \\\"type\\\": \\\"integer\\\",\\n                \\\"example\\\": 0\\n              },\\n              \\\"finish_reason\\\": {\\n                \\\"description\\\": \\\"The reason the model stopped generating tokens.\\\\nThis could be \\\\\\\"stop\\\\\\\" if it reached a natural stopping point or a specified stop sequence,\\\\n\\\\\\\"length\\\\\\\" if it hit the token limit, or \\\\\\\"content_filter\\\\\\\" if the content was filtered.\\\\n\\\",\\n                \\\"enum\\\": [\\n                  \\\"stop\\\",\\n                  \\\"length\\\",\\n                  \\\"content_filter\\\"\\n                ],\\n                \\\"type\\\": \\\"string\\\",\\n                \\\"example\\\": \\\"stop\\\"\\n              }\\n            }\\n          }\\n        },\\n        \\\"usage\\\": {\\n          \\\"description\\\": \\\"Usage statistics for the completion request\\\",\\n          \\\"required\\\": [\\n            \\\"prompt_tokens\\\",\\n            \\\"completion_tokens\\\",\\n            \\\"total_tokens\\\"\\n          ],\\n          \\\"type\\\": \\\"object\\\",\\n          \\\"properties\\\": {\\n            \\\"prompt_tokens\\\": {\\n              \\\"description\\\": \\\"Number of tokens in the prompt\\\",\\n              \\\"type\\\": \\\"integer\\\",\\n              \\\"example\\\": 56\\n            },\\n            \\\"completion_tokens\\\": {\\n              \\\"description\\\": \\\"Number of tokens in the completion\\\",\\n              \\\"type\\\": \\\"integer\\\",\\n              \\\"example\\\": 31\\n            },\\n            \\\"total_tokens\\\": {\\n              \\\"description\\\": \\\"Total number of tokens used (prompt + completion)\\\",\\n              \\\"type\\\": \\\"integer\\\",\\n              \\\"example\\\": 87\\n            }\\n          }\\n        }\\n      }\\n    },\\n    \\\"ErrorResponse\\\": {\\n      \\\"required\\\": [\\n        \\\"error\\\"\\n      ],\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"error\\\": {\\n          \\\"required\\\": [\\n            \\\"message\\\",\\n            \\\"type\\\",\\n            \\\"code\\\"\\n          ],\\n          \\\"type\\\": \\\"object\\\",\\n          \\\"properties\\\": {\\n            \\\"message\\\": {\\n              \\\"description\\\": \\\"A human-readable error message\\\",\\n              \\\"type\\\": \\\"string\\\",\\n              \\\"example\\\": \\\"You exceeded your current quota, please check your plan and billing details.\\\"\\n            },\\n            \\\"type\\\": {\\n              \\\"description\\\": \\\"The type of error returned\\\",\\n              \\\"type\\\": \\\"string\\\",\\n              \\\"example\\\": \\\"insufficient_quota\\\"\\n            },\\n            \\\"code\\\": {\\n              \\\"description\\\": \\\"A machine-readable error code\\\",\\n              \\\"type\\\": \\\"string\\\",\\n              \\\"example\\\": \\\"quota_exceeded\\\"\\n            }\\n          }\\n        }\\n      }\\n    }\\n  },\\n  \\\"securityDefinitions\\\": {\\n    \\\"BearerAuth\\\": { }\\n  },\\n  \\\"security\\\": [\\n    {\\n      \\\"BearerAuth\\\": [ ]\\n    }\\n  ]\\n}\"}"
